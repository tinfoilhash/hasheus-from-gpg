#!/usr/bin/env bash

# serves releases from $FAKE_GH_ROOT: releases.json for `release list`, and
# <tag>/ for each release's assets, whose urls point at
# https://github.example/<tag>/<name> (for the fake curl to serve). each asset
# has a sha256 digest, unless $FAKE_GH_NO_DIGESTS is set, like older releases.
# `api <endpoint>` serves $FAKE_GH_ROOT/api/<endpoint without its query>.json.
#
# for issues, `issue list` serves $FAKE_GH_ROOT/issues.json and `issue view <n>`
# serves $FAKE_GH_ROOT/issue-<n>.json. `issue create`, `comment`, and `close`
# are recorded in $FAKE_GH_LOG with the GH_TOKEN they ran with, and a created
# issue's body is saved as $FAKE_GH_ROOT/created-<n>.md.

case "$1 $2" in
  'release list')
    cat "$FAKE_GH_ROOT/releases.json"
    ;;
  'release view')
    tag="$3"

    for path in "$FAKE_GH_ROOT/$tag"/*; do
      digest=''
      if [ -z "${FAKE_GH_NO_DIGESTS:-}" ]; then
        digest="sha256:$(shasum -a 256 "$path" | cut -d ' ' -f 1)"
      fi

      jaq -n --arg tag "$tag" --arg name "${path##*/}" \
        --argjson size "$(wc -c < "$path")" --arg digest "$digest" '{
          name: $name,
          url: ("https://github.example/" + $tag + "/" + $name),
          contentType: "application/octet-stream",
          size: $size,
          digest: (if $digest == "" then null else $digest end)
        }'
    done | jaq -s '{ assets: . }'
    ;;
  'auth token')
    # `gh auth token --user <user>`.
    echo "token-for-$4"
    ;;
  'issue list')
    cat "$FAKE_GH_ROOT/issues.json" 2> /dev/null || echo '[]'
    ;;
  'issue view')
    cat "$FAKE_GH_ROOT/issue-$3.json" 2> /dev/null || echo '{"comments":[]}'
    ;;
  'issue create')
    shift 2
    while [ $# -gt 0 ]; do
      case "$1" in
        --repo) repo="$2" ;;
        --title) title="$2" ;;
        --body-file) body_file="$2" ;;
      esac
      shift
    done

    count=$(grep -c '^create ' "$FAKE_GH_LOG" 2> /dev/null)
    number=$((100 + count))
    cp "$body_file" "$FAKE_GH_ROOT/created-$number.md"
    echo "create $repo $title ($GH_TOKEN)" >> "$FAKE_GH_LOG"
    echo "https://github.com/$repo/issues/$number"
    ;;
  'issue comment' | 'issue close')
    action="$2"
    number="$3"
    shift 3
    text=''
    while [ $# -gt 0 ]; do
      case "$1" in
        --repo) repo="$2" ;;
        --body | --comment) text="$2" ;;
        --body-file) text=$(< "$2") ;;
      esac
      shift
    done

    echo "$action $repo#$number $text ($GH_TOKEN)" >> "$FAKE_GH_LOG"
    echo "https://github.com/$repo/issues/$number#issuecomment-1"
    ;;
  api\ *)
    cat "$FAKE_GH_ROOT/api/${2%%\?*}.json"
    ;;
  *)
    echo "fake gh: unexpected command: $*" >&2
    exit 1
    ;;
esac
