#!/usr/bin/env bash

# records published events in $FAKE_NAK_LOG ("<hash> <filename>" per line) and
# answers queries from it. queries fail like an unreachable relay while
# $FAKE_NAK_REQ_FAILURES (a file holding a count) is above 0.

case "$1" in
  key)
    printf '%064d\n' 0
    ;;
  decode)
    # like nak, print the hex key for an npub, or an error on stdout (with exit
    # 0) for anything else.
    if [[ "$2" =~ ^npub1[02-9ac-hj-np-z]{58}$ ]]; then
      printf '%064d\n' 1
    else
      echo "couldn't decode input '$2'"
    fi
    ;;
  req)
    if [ -n "${FAKE_NAK_REQ_FAILURES:-}" ] \
      && [ "$(cat "$FAKE_NAK_REQ_FAILURES")" -gt 0 ]; then
      echo $(($(cat "$FAKE_NAK_REQ_FAILURES") - 1)) > "$FAKE_NAK_REQ_FAILURES"
      exit 3
    fi

    for arg in "$@"; do
      case "$arg" in
        x=*) hash="${arg#x=}" ;;
      esac
    done

    if grep -q "^$hash " "$FAKE_NAK_LOG" 2> /dev/null; then
      echo "{\"kind\":1063,\"tags\":[[\"x\",\"$hash\"]]}"
    fi
    ;;
  event)
    while [ $# -gt 0 ]; do
      case "$1" in
        -c) filename="$2" ;;
        -t) [[ "$2" == x=* ]] && hash="${2#x=}" ;;
      esac
      shift
    done

    if [ "$filename" = "${FAKE_NAK_FAIL:-}" ]; then
      echo 'fake nak: publish failed' >&2
      exit 1
    fi

    echo "$hash $filename" >> "$FAKE_NAK_LOG"
    echo 'publishing to fake relay... success.'
    ;;
  *)
    echo "fake nak: unexpected command: $*" >&2
    exit 1
    ;;
esac
