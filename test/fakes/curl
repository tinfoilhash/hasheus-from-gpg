#!/usr/bin/env bash

# serves https://<host>/<path> from $FAKE_CURL_ROOT/<host>/<path> (index.html
# for a path ending in /), failing like `curl -f` when it's missing.

url=''
output_filename=''
head_only=false
write_status=false

while [ $# -gt 0 ]; do
  case "$1" in
    --head | -I) head_only=true ;;
    --write-out | -w)
      write_status=true
      shift
      ;;
    -o)
      output_filename="$2"
      shift
      ;;
    --connect-timeout | --max-time | --speed-limit | --speed-time) shift ;;
    -*) ;;
    *) url="$1" ;;
  esac
  shift
done

path="$FAKE_CURL_ROOT/${url#https://}"
if [[ "$path" == */ ]]; then
  path+='index.html'
fi
filename="${url##*/}"

if [ -n "${FAKE_CURL_REQUEST_LOG:-}" ]; then
  echo "$url" >> "$FAKE_CURL_REQUEST_LOG"
fi

if [ "$write_status" = true ]; then
  if [ -n "${FAKE_CURL_TRANSPORT_FAIL:-}" ] \
    && [ "$filename" = "$FAKE_CURL_TRANSPORT_FAIL" ]; then
    exit 28
  fi
  if [ -n "${FAKE_CURL_STATUS_FILE:-}" ] \
    && [ "$filename" = "$FAKE_CURL_STATUS_FILE" ]; then
    echo "${FAKE_CURL_STATUS:-503}"
  elif [ ! -f "$path" ]; then
    echo 404
  else
    echo 200
  fi
  exit
fi

if [ "$head_only" = true ]; then
  path+='.headers'
fi

if [ -n "${FAKE_CURL_FAIL:-}" ] && [ "$filename" = "$FAKE_CURL_FAIL" ] \
  || [ ! -f "$path" ]; then
  echo "curl: (22) The requested URL returned error: 404" >&2
  exit 22
fi

if [ -z "$output_filename" ]; then
  cat "$path"
  exit
fi

cp "$path" "$output_filename"

if [ -n "${FAKE_CURL_LOG:-}" ]; then
  echo "$filename" >> "$FAKE_CURL_LOG"
fi
