<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- runs daily_run.sh at 9:00 each day, or when the mac wakes if it was asleep
then, in your shell as a login shell, so it gets NSEC and PATH from your
shell's startup files. LOGIN_SHELL, CLONE_DIR, and HOME_DIR are filled in when
it's installed (see the readme). -->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.tinfoilhash.verify-from-gpg.daily</string>
    <key>ProgramArguments</key>
    <array>
      <string>LOGIN_SHELL</string>
      <string>-l</string>
      <string>-c</string>
      <string>'CLONE_DIR/daily_run.sh'</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>9</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>HOME_DIR/Library/Logs/verify-from-gpg/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>HOME_DIR/Library/Logs/verify-from-gpg/launchd.log</string>
  </dict>
</plist>
